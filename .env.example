# Dynamic Labs
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id

# OpenAI (for prediction generation)
OPENAI_API_KEY=your_openai_api_key

# Default Chain (1243 = Arc Testnet, 56 = BNB Chain, 97 = BNB Chain Testnet)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1243

# Arc Testnet RPC
ARC_RPC_URL=https://rpc-testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc-testnet.arc.network

# BNB Chain Mainnet RPC
BNB_RPC_URL=https://bsc-dataseed1.binance.org
NEXT_PUBLIC_BNB_RPC_URL=https://bsc-dataseed1.binance.org

# BNB Chain Testnet RPC
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
NEXT_PUBLIC_BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Private key for deployment (NEVER commit this)
PRIVATE_KEY=your_private_key_here

# Arc Testnet Contract Addresses
# Official Arc Testnet USDC address: https://docs.arc.network/arc/references/contract-addresses#usdc
# USDC on Arc uses 6 decimals (not 18)
NEXT_PUBLIC_USDC_CONTRACT_ARC=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT_ARC=

# BNB Chain Mainnet Contract Addresses
# Official BNB Chain USDC: 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
# USDC on BNB Chain uses 18 decimals
NEXT_PUBLIC_USDC_CONTRACT_BNB=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT_BNB=

# BNB Chain Testnet Contract Addresses
# BNB Testnet USDC: 0x64544969ed7EBf5f083679233325356EbE738930
# USDC on BNB Chain uses 18 decimals
NEXT_PUBLIC_USDC_CONTRACT_BNB_TESTNET=0x64544969ed7EBf5f083679233325356EbE738930
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT_BNB_TESTNET=

# Legacy/Backward Compatibility (uses default chain)
NEXT_PUBLIC_USDC_CONTRACT=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_PREDICTION_MARKET_CONTRACT=

# Circle Wallets (Account Abstraction)
# TODO: Add Circle Wallets API credentials
# See: https://developers.circle.com/w3s/docs
CIRCLE_WALLET_API_KEY=your_circle_wallet_api_key
CIRCLE_WALLET_BASE_URL=your_circle_wallet_base_url

